<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinBrowser.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinBrowser"
    Title="WinBrowser">

    <Grid x:Name="Root" RequestedTheme="Dark">
        <Grid.Resources>
            <!-- Flat buttons: no grey plate when disabled, soft white wash on hover -->
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#33FFFFFF" />
            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SidebarHoverBrush" />
            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SidebarSelectedBrush" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#F2FFFFFF" />
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Title strip: nav buttons on the left, Windows caption buttons on the right ============ -->
        <StackPanel x:Name="Toolbar" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="2"
                    Margin="8,0,0,0" VerticalAlignment="Top" Height="32">
            <Button x:Name="SidebarToggleButton" Style="{StaticResource GhostIconButton}" Content="&#xE89F;"
                    Click="SidebarToggle_Click" ToolTipService.ToolTip="Toggle sidebar (Ctrl+S)" AutomationProperties.Name="Toggle sidebar" />
            <Button x:Name="BackButton" Style="{StaticResource GhostIconButton}" Content="&#xE72B;"
                    Click="Back_Click" ToolTipService.ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back" />
            <Button x:Name="ForwardButton" Style="{StaticResource GhostIconButton}" Content="&#xE72A;"
                    Click="Forward_Click" ToolTipService.ToolTip="Forward (Alt+Right)" AutomationProperties.Name="Forward" />
            <Button x:Name="ReloadButton" Style="{StaticResource GhostIconButton}" Content="&#xE72C;"
                    Click="Reload_Click" ToolTipService.ToolTip="Reload (Ctrl+R)" AutomationProperties.Name="Reload" />
        </StackPanel>

        <!-- Find-in-page lives in the title strip because nothing can overlap the native page surface -->
        <Border x:Name="FindBar" Grid.Column="1" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0" Height="28"
                Background="{StaticResource PillBrush}" CornerRadius="8" Padding="8,0,2,0">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <FontIcon Glyph="&#xE721;" FontSize="12" Foreground="{StaticResource SidebarSubtleTextBrush}" Margin="0,0,4,0" />
                <TextBox x:Name="FindBox" Width="200" MinHeight="0" Height="26" Padding="4,3,4,0" FontSize="13"
                         BorderThickness="0" PlaceholderText="Find in page" Loaded="TextBox_HideClearButton"
                         TextChanged="FindBox_TextChanged" KeyDown="FindBox_KeyDown">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    </TextBox.Resources>
                </TextBox>
                <Button Style="{StaticResource GhostIconButton}" Width="26" Height="26" FontSize="10" Content="&#xE70E;"
                        Click="FindPrev_Click" ToolTipService.ToolTip="Previous (Shift+Enter)" AutomationProperties.Name="Previous match" />
                <Button Style="{StaticResource GhostIconButton}" Width="26" Height="26" FontSize="10" Content="&#xE70D;"
                        Click="FindNext_Click" ToolTipService.ToolTip="Next (Enter)" AutomationProperties.Name="Next match" />
                <Button Style="{StaticResource GhostIconButton}" Width="26" Height="26" FontSize="10" Content="&#xE8BB;"
                        Click="FindClose_Click" ToolTipService.ToolTip="Close (Esc)" AutomationProperties.Name="Close find" />
            </StackPanel>
        </Border>

        <!-- ============ Sidebar ============ -->
        <Grid x:Name="Sidebar" Grid.Row="1" Padding="8,0,8,8" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Address pill -->
            <Border x:Name="AddressPill" Height="38" CornerRadius="10" Background="{StaticResource PillBrush}"
                    Padding="10,0,4,0">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="SecurityIcon" Glyph="&#xE72E;" FontSize="11"
                              Foreground="{StaticResource SidebarSubtleTextBrush}" />
                    <TextBox x:Name="AddressBox" Grid.Column="1" BorderThickness="0" MinHeight="0" Height="32"
                             Padding="0,6,0,0" FontSize="13" VerticalAlignment="Center"
                             PlaceholderText="Search or enter URL" IsSpellCheckEnabled="False" Loaded="TextBox_HideClearButton"
                             GotFocus="AddressBox_GotFocus" LostFocus="AddressBox_LostFocus" KeyDown="AddressBox_KeyDown">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlForeground" Color="#E6FFFFFF" />
                            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#E6FFFFFF" />
                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#73FFFFFF" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#73FFFFFF" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#73FFFFFF" />
                        </TextBox.Resources>
                    </TextBox>
                    <Button x:Name="CopyLinkButton" Grid.Column="2" Style="{StaticResource GhostIconButton}"
                            Width="28" Height="28" FontSize="12" Content="&#xE71B;"
                            Click="CopyLink_Click" ToolTipService.ToolTip="Copy link (Ctrl+Shift+C)" AutomationProperties.Name="Copy link" />
                </Grid>
            </Border>

            <!-- New tab -->
            <Button x:Name="NewTabButton" Grid.Row="1" Margin="0,14,0,4" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" Height="36" Padding="10,0" CornerRadius="8"
                    Background="Transparent" BorderThickness="0" Click="NewTab_Click" IsTabStop="False" AutomationProperties.Name="New Tab">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{StaticResource SidebarSubtleTextBrush}" />
                    <TextBlock Text="New Tab" FontSize="13" Foreground="{StaticResource SidebarSubtleTextBrush}" />
                </StackPanel>
            </Button>

            <!-- Vertical tabs -->
            <ListView x:Name="TabList" Grid.Row="2" SelectionMode="Single"
                      CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                      SelectionChanged="TabList_SelectionChanged" Padding="0" IsTabStop="False">
                <ListView.Resources>
                    <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                    <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="SidebarHoverBrush" />
                    <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="SidebarHoverBrush" />
                    <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="SidebarSelectedBrush" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="SidebarSelectedBrush" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="SidebarSelectedBrush" />
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinHeight" Value="36" />
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Padding" Value="10,0,4,0" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:BrowserTab">
                        <Grid ColumnSpacing="12" Background="Transparent"
                              PointerEntered="TabItem_PointerEntered" PointerExited="TabItem_PointerExited"
                              PointerPressed="TabItem_PointerPressed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE774;" FontSize="13" Foreground="{StaticResource SidebarSubtleTextBrush}"
                                      Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                            <Image Width="16" Height="16" Source="{x:Bind Favicon, Mode=OneWay}"
                                   Visibility="{x:Bind FaviconVisibility, Mode=OneWay}" />
                            <ProgressRing Width="14" Height="14" MinWidth="0" MinHeight="0" IsActive="{x:Bind IsLoading, Mode=OneWay}"
                                          Visibility="{x:Bind SpinnerVisibility, Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind DisplayTitle, Mode=OneWay}" FontSize="13"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Foreground="{StaticResource SidebarTextBrush}" />
                            <Button Grid.Column="2" Style="{StaticResource GhostIconButton}" Width="24" Height="24"
                                    FontSize="9" CornerRadius="6" Content="&#xE8BB;" Tag="{x:Bind}"
                                    Opacity="{x:Bind CloseButtonOpacity, Mode=OneWay}" Click="CloseTab_Click"
                                    ToolTipService.ToolTip="Close tab (Ctrl+W)" AutomationProperties.Name="Close tab" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ============ Page surface: the native Chromium window is positioned over this card ============ -->
        <Border x:Name="BrowserHost" Grid.Row="1" Grid.Column="1" Margin="0,0,8,8" CornerRadius="8"
                Background="{StaticResource ContentPlaceholderBrush}" SizeChanged="BrowserHost_SizeChanged" />
    </Grid>
</Window>
