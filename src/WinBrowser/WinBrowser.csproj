<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>WinBrowser</RootNamespace>
    <AssemblyName>WinBrowser</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WinBrowser.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CEF binaries + native host produced by native/CMakeLists.txt -->
    <NativeBinDir>$(MSBuildThisFileDirectory)..\..\build\native\bin\</NativeBinDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\newtab.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\WinBrowser.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Copy libcef, its resources, WinBrowserCore.dll and the helper exe next to WinBrowser.exe -->
  <ItemGroup Condition="Exists('$(NativeBinDir)')">
    <None Include="$(NativeBinDir)**\*" Exclude="$(NativeBinDir)**\*.pdb;$(NativeBinDir)**\*.lib;$(NativeBinDir)**\*.exp"
          Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
