<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WinBrowser.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Minimal palette -->
            <SolidColorBrush x:Key="SidebarTextBrush" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="SidebarSubtleTextBrush" Color="#8CFFFFFF" />
            <SolidColorBrush x:Key="SidebarHoverBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="PillBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ContentPlaceholderBrush" Color="#FF1E1E22" />

            <!-- Borderless icon button used in the title bar and sidebar -->
            <Style x:Key="GhostIconButton" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource SidebarSubtleTextBrush}" />
                <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="IsTabStop" Value="False" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
